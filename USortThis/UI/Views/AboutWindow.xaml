<Window x:Class="USortThis.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:USortThis.UI.Views"
        mc:Ignorable="d"
        Title="About" Height="250" Width="400"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="USortThis" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Version 1.0.0" FontSize="14" Margin="0,0,0,20"/>
            <TextBlock Text="USortThis is a powerful sorting tool designed to help you organize your files efficiently." TextWrapping="Wrap"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Width="80" Height="30" HorizontalAlignment="Center" Margin="0,0,10,10" Click="CloseButton_Click"/>
    </Grid>
</Window>
