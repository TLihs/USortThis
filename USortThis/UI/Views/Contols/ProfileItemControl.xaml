<UserControl x:Class="USortThis.UI.Views.Controls.ProfileItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:USortThis.UI.Views.Controls"
             xmlns:vm="clr-namespace:USortThis.Core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="600">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Style>

    <Border x:Name="RootBorder"
            Padding="8"
            Margin="4"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{StaticResource SurfaceBackgroundBrush}"
            AllowDrop="True"
            Drop="RootBorder_Drop">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Start"
                            Command="{Binding DataContext.StartProfileSortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Profile}"
                            Width="64"
                            Margin="4,0,0,0" />
                    <Button Content="Stop"
                            Command="{Binding DataContext.StopProfileSortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Profile}"
                            Width="64"
                            Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Progress, StringFormat=Progress: {0}%}"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,6,0,2" />
            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="16" />
        </Grid>
    </Border>
</UserControl>
