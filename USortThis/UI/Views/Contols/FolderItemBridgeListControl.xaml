<UserControl x:Class="USortThis.UI.Views.Controls.FolderItemBridgeListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:USortThis.UI.Views.Controls"
             xmlns:controls="clr-namespace:USortThis.UI.Views.Controls"
             xmlns:vm="clr-namespace:USortThis.Core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border x:Name="RootBorder" Padding="8" Margin="4" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{StaticResource SurfaceBackgroundBrush}">
        <Grid>
            <ListBox ItemsSource="{Binding DataContext.BridgeItems, RelativeSource={RelativeSource AncestorType=Window}}"
                     SelectedItem="{Binding DataContext.SelectedBridge, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid SnapsToDevicePixels="True">
                                        <Border x:Name="SelectionSurface"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                        <Border x:Name="SelectionIndicator"
                                                Width="4"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="2"
                                                Visibility="Collapsed" />
                                        <ContentPresenter Margin="7,0,0,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionSurface" Property="Background" Value="{StaticResource SelectionBrush}" />
                                            <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:FolderItemBridgeControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
