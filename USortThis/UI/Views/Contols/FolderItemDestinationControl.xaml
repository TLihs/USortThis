<UserControl x:Class="USortThis.UI.Views.Controls.FolderItemDestinationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:USortThis.UI.Views.Controls"
             xmlns:vm="clr-namespace:USortThis.Core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="150"
             Width="150" Height="150"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver">
    <Border Padding="8" Margin="6" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceBackgroundBrush}" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Icon placeholder -->
                <Rectangle Width="48" Height="48" Fill="{StaticResource RaisedBackgroundBrush}" RadiusX="6" RadiusY="6" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="4,8,4,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="{Binding Status}" Foreground="#75B798" FontSize="12" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding FileCount, StringFormat='Files: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
