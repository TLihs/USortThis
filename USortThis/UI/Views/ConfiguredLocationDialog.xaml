<Window x:Class="USortThis.UI.Views.ConfiguredLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configured Location" Height="390" Width="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="Display name" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="TextBox_Label" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="1" Text="Path (drive, folder, UNC/IP)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="TextBox_Path" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
        <CheckBox x:Name="CheckBox_CurrentCredentials" Grid.Row="2" Grid.Column="1" Content="Use current Windows credentials" IsChecked="True" Margin="0,8"/>
        <TextBlock Grid.Row="3" Text="Domain (optional)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="TextBox_Domain" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="4" Text="Username" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="TextBox_Username" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
        <TextBlock Grid.Row="5" Text="Password" VerticalAlignment="Center" Margin="0,4"/>
        <PasswordBox x:Name="PasswordBox_Password" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
        <TextBlock x:Name="TextBlock_Status" Grid.Row="6" Grid.ColumnSpan="2" Foreground="Orange" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Test" Width="80" Margin="4" Click="Test_Click"/>
            <Button Content="Save" Width="80" Margin="4" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
