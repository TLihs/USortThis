<Window x:Class="USortThis.UI.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:services="clr-namespace:USortThis.Core.Services"
        xmlns:templates="clr-namespace:USortThis.UI.Views.Templates"
        mc:Ignorable="d"
        Title="{Binding EditorTitle}" Height="700" Width="900"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <services:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter" />

        <!-- Data templates for filter criteria -->
        <DataTemplate x:Key="NoneTemplate">
            <TextBlock Text="No filter" />
        </DataTemplate>

        <DataTemplate x:Key="RouteTemplate">
            <StackPanel Margin="4">
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,4">
                    <Button Content="Browse" Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Margin="4,0,0,0" />
                    <TextBox Text="{Binding DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Destination folder" />
                </DockPanel>
                <CheckBox Content="Keep source folder structure" IsChecked="{Binding PreserveRelativePath, Mode=TwoWay}" Margin="0,0,0,4" />
                <TextBox Text="{Binding DateFolderPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Date pattern, for example yyyy-MM-dd or yyyy\\MM\\dd" Margin="0,0,0,4" />
                <CheckBox Content="Use file creation time (otherwise last modified time)" IsChecked="{Binding UseCreationTime, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ExtensionTemplate">
            <StackPanel>
                <TextBlock Text="Extensions:"/>
                <TextBox Text="{Binding Model.Extensions}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileNameTemplate">
            <StackPanel>
                <TextBlock Text="File name filter:"/>
                <TextBox Text="{Binding Model.Pattern}"/>
                <CheckBox Content="Use Regex" IsChecked="{Binding Model.UseRegex}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MinDateTemplate">
            <StackPanel>
                <TextBlock Text="Min. Date:"/>
                <TextBox Text="{Binding Model.MinDate}"/>
                <CheckBox Content="Use Creation Time" IsChecked="{Binding Model.UseCreationTime}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MaxDateTemplate">
            <StackPanel>
                <TextBlock Text="Max. Date:"/>
                <TextBox Text="{Binding Model.MaxDate}"/>
                <CheckBox Content="Use Creation Time" IsChecked="{Binding Model.UseCreationTime}"/>
            </StackPanel>
        </DataTemplate>

        <templates:FilterRuleCriteriaTemplateSelector x:Key="CriteriaSelector"
                                                      NoneTemplate="{StaticResource NoneTemplate}"
                                                      ExtensionTemplate="{StaticResource ExtensionTemplate}"
                                                      FileNameTemplate="{StaticResource FileNameTemplate}"
                                                      MinDateTemplate="{StaticResource MinDateTemplate}"
                                                      MaxDateTemplate="{StaticResource MaxDateTemplate}"/>
    </Window.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*"/>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="When destination file exists:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding ConflictHandlingOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding ConflictHandling, Mode=TwoWay}"
                          Width="150" />
            </StackPanel>
            <TextBlock Text="Profile name:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="260" MaxWidth="500" />
        </DockPanel>

        <Grid Grid.Row="1">
            <GroupBox Header="Folder Bridges">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <Button Content="Add Bridge" Command="{Binding AddBridgeCommand}" Width="90" />
                        <Button Content="Remove Bridge" Command="{Binding RemoveBridgeCommand}" Width="100" Margin="6,0,0,0" />
                    </StackPanel>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Bridges}" SelectedItem="{Binding SelectedBridge, Mode=TwoWay}" DisplayMemberPath="CustomName" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Bridge name" />
                            <TextBox Text="{Binding BridgeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Source folder (blank means drop files/folders onto the bridge)" Margin="0,6,0,0" />
                            <DockPanel>
                                <Button Content="Browse" Command="{Binding BrowseSourceCommand}" DockPanel.Dock="Right" Margin="4,0,0,0" />
                                <TextBox Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding ConfiguredLocations}" SelectedItem="{Binding SelectedSourceLocation, Mode=TwoWay}" DisplayMemberPath="Label" ToolTip="Select a configured location for the source" Margin="0,4,0,0" />
                            <CheckBox Content="Move source files after all matching routes succeed" IsChecked="{Binding MoveSourceAfterCopy, Mode=TwoWay}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Main area: routing rules -->
        <Grid Grid.Row="2">
            <GroupBox Header="Routes">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
                        <Button x:Name="Btn_AddRule" Content="Add Route" Command="{Binding AddRouteCommand}" Width="90"/>
                        <Button x:Name="Btn_RemoveRule" Content="Remove Rule" Command="{Binding RemoveRuleCommand}" Width="100" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="List_Rules" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}" ItemTemplate="{StaticResource RouteTemplate}" Margin="4" SelectionChanged="List_Rules_SelectionChanged" />
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Criteria detail panel -->
        <Grid Grid.Row="3">
            <GroupBox Header="Rule Criteria">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,6">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#FFFF8A8A" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding ValidationWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#FFFFB454" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Add/Remove criteria buttons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4" Height="Auto">
                        <TextBlock Text="Add:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding AvailableCriteriaTypes}" 
                                  SelectedItem="{Binding SelectedCriteriaType, Mode=TwoWay}"
                                  Width="100" Height="24"/>
                        <Button Content="Add Criteria" Command="{Binding AddCriteriaCommand}" Width="100" Margin="6,0,0,0" Height="24"/>
                        <Button Content="Remove" Command="{Binding RemoveCriteriaCommand}" Width="80" Margin="6,0,0,0" Height="24"/>
                    </StackPanel>

                    <!-- Criteria list with templates -->
                    <ListBox x:Name="List_Criteria" 
                             ItemsSource="{Binding RuleCriteria}"
                             SelectedItem="{Binding SelectedCriteria, Mode=TwoWay}"
                             ItemTemplateSelector="{StaticResource CriteriaSelector}"
                             Margin="4" 
                             SelectionChanged="List_Criteria_SelectionChanged" />
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Bottom: save button -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="36" Margin="0,0,8,0"/>
            <Button x:Name="Btn_SaveNow" Content="Save" Command="{Binding SaveCommand}" Width="100" Height="36"/>
        </StackPanel>
    </Grid>
</Window>